# PostgreSQL configuration
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SCHEMA=your_schema_name

# Uvicorn server configuration
UVICORN_HOST=0.0.0.0
UVICORN_PORT=5000

# Backend configuration
BACKEND_URL=http://localhost:5000
BACKEND_TIMEOUT=5

# Password policy
PASSWORD_MIN_LENGTH=16

# Certificate signing key (Ed25519)
# Generate a key pair using the provided key generation script.
# Replace this placeholder with the generated private key.
CERT_SIGNING_PRIVATE_KEY=
